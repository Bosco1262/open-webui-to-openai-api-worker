{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-webui-to-openai-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV"
      // Omitting id = Automatic Resource Provisioning (Beta): on `wrangler deploy`
      // or Workers Builds deploys, a KV Namespace is created automatically
      // (prefixed with the Worker name), enabling one-click deploy after fork.
      //
      // To reuse an existing KV, fill in "id": "<your KV namespace id>" here.
      //
      // 不填 id = 自动资源供应（Beta）：wrangler deploy 或 Workers Builds 部署时会
      // 自动创建 KV Namespace（以 Worker 名为前缀），实现 fork 后一键部署。
      //
      // 如需复用已有 KV，可在此补上 "id": "<你的 KV namespace id>"。
    }
  ],
  // Explicitly disabled: no *.workers.dev route and no per-version preview URLs.
  // Access must go through a custom domain / route bound to this Worker.
  //
  // 显式关闭：不启用 *.workers.dev 子域，也不生成按版本的预览地址。
  // 需要通过绑定到该 Worker 的自定义域名 / 路由访问。
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
